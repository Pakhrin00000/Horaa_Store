<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="100%" height="100%">
  <rect width="600" height="600" fill="#0a0c14"/>
  <g transform="translate(160, 80)">
    <rect width="280" height="400" rx="14" fill="#121624" stroke="#00f0ff" stroke-width="4"/>
    <!-- Glass Panel -->
    <rect x="25" y="25" width="230" height="350" rx="8" fill="rgba(0, 240, 255, 0.05)" stroke="rgba(255, 0, 85, 0.4)" stroke-width="2"/>
    <!-- Liquid Cooler RGB Rings -->
    <circle cx="100" cy="90" r="30" fill="none" stroke="#00f0ff" stroke-width="6"/>
    <circle cx="180" cy="90" r="30" fill="none" stroke="#ff0055" stroke-width="6"/>
    <!-- GPU Card -->
    <rect x="50" y="200" width="180" height="45" rx="6" fill="#1a2035" stroke="#00f0ff" stroke-width="2"/>
    <text x="140" y="228" font-family="'Orbitron', sans-serif" font-size="14" font-weight="700" fill="#00f0ff" text-anchor="middle">RTX 4090 24GB</text>
    <!-- RAM Sticks -->
    <rect x="180" y="130" width="10" height="45" rx="2" fill="#ff0055"/>
    <rect x="195" y="130" width="10" height="45" rx="2" fill="#00f0ff"/>
  </g>
  <text x="300" y="540" font-family="'Orbitron', sans-serif" font-size="20" font-weight="700" fill="#ffffff" text-anchor="middle">HORAA TITAN CYBER RIG</text>
</svg>
