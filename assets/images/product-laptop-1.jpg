<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="100%" height="100%">
  <rect width="600" height="600" fill="#0a0c14"/>
  <g transform="translate(100, 150)">
    <!-- Screen -->
    <rect x="50" y="20" width="300" height="190" rx="10" fill="#121624" stroke="#00f0ff" stroke-width="4"/>
    <rect x="65" y="35" width="270" height="160" fill="#0a0c14"/>
    <text x="200" y="120" font-family="'Orbitron', sans-serif" font-size="18" font-weight="700" fill="#ff0055" text-anchor="middle">OLED 240Hz</text>
    <!-- Base -->
    <path d="M 10 215 L 390 215 L 420 250 L -20 250 Z" fill="#1a2035" stroke="#00f0ff" stroke-width="3"/>
    <rect x="140" y="222" width="120" height="20" rx="4" fill="#00f0ff" opacity="0.4"/>
  </g>
  <text x="300" y="480" font-family="'Orbitron', sans-serif" font-size="20" font-weight="700" fill="#00f0ff" text-anchor="middle">HORAA BLADE PRO 16"</text>
</svg>
